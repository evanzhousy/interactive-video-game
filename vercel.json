{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/studio/(.*)",
      "destination": "/studio.html"
    }
  ],
  "functions": {
    "api/interrogate.ts": {
      "maxDuration": 30
    },
    "api/generate-visitors.ts": {
      "maxDuration": 45
    },
    "api/rephrase.ts": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(portraits|audio|videos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
