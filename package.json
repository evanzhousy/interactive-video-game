{
  "name": "quarantine-gate-0",
  "version": "0.1.0",
  "private": true,
  "description": "Quarantine Gate 0: 2036 (零号隔离窗) — Claustrophobic Svalbard quarantine interrogation game powered by the Ordamor Persona Engine (schemaVersion 6).",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "sync:ordamor": "tsx scripts/sync-ordamor.ts",
    "media:manifest": "tsx scripts/generate-media-pack.ts",
    "media:tts": "tsx scripts/generate-media-pack.ts --synthesize-tts",
    "media:videos": "tsx scripts/generate-videos.ts",
    "media:pull-drive": "tsx scripts/pull-gdrive-videos.ts",
    "media:push-drive": "tsx scripts/push-gdrive-assets.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.2",
    "@ui-sdk/core": "0.1.0-beta.7",
    "@ui-sdk/react": "0.1.0-beta.7",
    "@vfx-js/core": "^1.6.0",
    "ai": "^7.0.177",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^21.0.4",
    "tsx": "4.21.0",
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "vitest": "^4.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
