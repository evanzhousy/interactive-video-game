{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quarantine Gate 0",
  "version": "0.2.0",
  "identifier": "com.ordamor.quarantinegate0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quarantine Gate 0: 2036 · 零号隔离窗",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; media-src 'self' blob: data:; connect-src 'self' https: http://127.0.0.1:*"
    }
  }
}
